<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputType>Library</OutputType>
    <NoWarn>1701;1702;1705;1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Messaging.EventHubs.Processor" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="DotNetty.Buffers" />
    <PackageReference Include="LagoVista.IoT.Runtime.Core" />
    <PackageReference Include="Microsoft.Azure.Devices.Client" />
    <PackageReference Include="Microsoft.Azure.Devices.Shared" />
    <PackageReference Include="LagoVista.MQTT" />
    <PackageReference Include="AMQPNetLite" />
    <PackageReference Include="LagoVista.Client.Core" />
    <PackageReference Include="Portable.BouncyCastle" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\LagoVista.IoT.Simulator.Models\LagoVista.IoT.Simulator.Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="SimulatorRuntimeResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SimulatorRuntimeResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="SimulatorRuntimeResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>SimulatorRuntimeResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
